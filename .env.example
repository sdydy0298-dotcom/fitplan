# New dedicated Supabase project (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SERVER ONLY: set in .env.local and Vercel, never prefix with NEXT_PUBLIC_
# Supabase's secret API key or legacy service_role key
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
